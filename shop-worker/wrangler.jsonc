{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "campeach-shop",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PAGADITO_MODE": "production",
    "STORE_ORIGIN": "https://campeach-rd.github.io"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
