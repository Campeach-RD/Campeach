{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "campeach-instagram",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "OPENAI_MODEL": "gpt-5.6-luna",
    "PUBLIC_WORKER_URL": "https://campeach-instagram.nomanychat.workers.dev"
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "DEDUP"
    }
  ],
  "d1_databases": [
    {
      "binding": "WHATSAPP_DB",
      "database_name": "campeach-whatsapp",
      "database_id": "7f5589bc-56bb-459a-9d3d-156e90c1849b",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
